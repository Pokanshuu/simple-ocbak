{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-ocbak.dev/schema/ocbak-1.0.envelope.schema.json",
  "title": ".ocbak 1.0 信封",
  "description": "只约束不可协商的部分：信封必填键、对象必带 key、边与素材的骨架。实体字段是开放的，本 schema 不校验、也不禁止。",
  "type": "object",
  "required": ["format", "protocol", "producer", "createdAt", "scope", "data", "relations", "assets"],
  "additionalProperties": true,
  "properties": {
    "format": { "const": "ocbak" },
    "protocol": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "major.minor。读取方接受同一 major；minor 更高时仍可尝试读取并报告 NEWER_MINOR。"
    },
    "producer": {
      "type": "object",
      "required": ["app", "version"],
      "additionalProperties": true,
      "properties": {
        "app": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": true,
          "properties": { "kind": { "const": "library" } }
        },
        {
          "type": "object",
          "required": ["kind", "root"],
          "additionalProperties": true,
          "properties": {
            "kind": { "const": "subgraph" },
            "root": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
            "depth": { "type": "integer", "minimum": -1, "description": "-1 表示不限深度" }
          }
        }
      ]
    },
    "includes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sections": { "type": "array", "items": { "type": "string" } },
        "assets": { "enum": ["embedded", "referenced", "none"] }
      }
    },
    "data": {
      "type": "object",
      "description": "段容器：键为小写复数段名，值为对象数组。段名开放。",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["key"],
          "additionalProperties": true,
          "properties": { "key": { "$ref": "#/$defs/key" } }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "kind"],
        "additionalProperties": true,
        "properties": {
          "key": { "type": "string" },
          "source": { "$ref": "#/$defs/ref" },
          "target": { "$ref": "#/$defs/ref" },
          "kind": {
            "type": "string",
            "description": "闭集：character / membership / event-character / event-country / event-event / nation / custom。写入方只应用闭集内的值；读取方遇到其它值必须保留并按 custom 显示。"
          },
          "label": { "type": "string" },
          "directed": { "type": "boolean" },
          "color": { "type": ["string", "null"] },
          "arrow": { "enum": ["none", "forward", "reverse", "both"] },
          "world": { "type": ["string", "null"] },
          "createdAt": { "type": "number" },
          "updatedAt": { "type": "number" }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "mime"],
        "additionalProperties": true,
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "mime": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif",
              "image/avif",
              "image/svg+xml",
              "video/mp4",
              "video/webm"
            ]
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "data": { "type": "string", "description": "base64，不含 data: 前缀（载体 A）" },
          "path": { "type": "string", "description": "包内相对路径（载体 B）" },
          "width": { "type": "integer", "minimum": 0 },
          "height": { "type": "integer", "minimum": 0 }
        },
        "oneOf": [
          { "required": ["data"], "not": { "required": ["path"] } },
          { "required": ["path"], "not": { "required": ["data"] } }
        ]
      }
    },
    "ext": {
      "type": "object",
      "description": "按实现方短名分命名空间。写入方不得删改别人的命名空间。",
      "additionalProperties": true
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "同类对象内唯一，生成一次永不变。"
    },
    "ref": {
      "type": "string",
      "pattern": "^(character|event|country|worldEntry|tag|period|world|map):[A-Za-z0-9._-]{1,64}$",
      "description": "<type>:<key>"
    }
  }
}
